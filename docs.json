{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Weav Documentation",
  "colors": {
    "primary": "#2052EB",
    "light": "#2052EB",
    "dark": "#2052EB"
  },
  "favicon": {
    "light": "/images/weav.png",
    "dark": "/images/weav.png"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Blog",
          "icon": "newspaper",
          "href": "https://weav.com/blog"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index"
            ]
          },
          {
            "group": "Quick Start",
            "pages": [
              "quick-start/configure-workspace",
              "quick-start/build-your-first-ai-agent",
              "quick-start/train-your-agents",
              "quick-start/connect-channels"
            ]
          },
          {
            "group": "Agents",
            "pages": [
              "agents/general-settings",
              "agents/email-settings",
              "agents/emails",
              "agents/playground",
              "agents/escalation-rules",
              "agents/prohibited-phrases",
              "agents/quick-prompts"
            ]
          },
          {
            "group": "Inbox",
            "pages": [
              "inbox/forward-emails-to-weav",
              "inbox/email-forwarding",
              "inbox/dns-settings",
              "inbox/google-groups-setup"
            ]
          },
          {
            "group": "Settings",
            "pages": [
              "settings/overview",
              "settings/workflows"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/customer-verification",
              "integrations/custom-actions",
              "integrations/framer",
              "integrations/google-drive",
              "integrations/shopify",
              "integrations/stripe",
              "integrations/whatsapp"
            ]
          }
        ]
      },
      {
        "tab": "Developers",
        "openapi": "api-reference/openapi.json",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction",
              "api-reference/chatbot",
              "api-reference/mcp"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/weav-logo-full.png",
    "dark": "/images/documentation-logo.png",
    "href": "https://docs.weav.com"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.weav.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/weavdotcom",
      "website": "https://weav.com"
    }
  },
  "api": {
    "openapi": "/api-reference/openapi.json"
  },
  "integrations": {
    "fathom": {
      "siteId": "EJSRSMDQ"
    }
  },
  "seo": {
    "indexing": "all"
  }
}
